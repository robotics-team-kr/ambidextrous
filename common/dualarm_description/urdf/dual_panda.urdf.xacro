<?xml version="1.0"?>
<!--
  Two Panda arms on a common base frame ("world"), facing +x.
  left arm at y = +arm_y, right arm at y = -arm_y.

  Placeholder until the HW team's spec arrives: swap this file (and the SRDF in
  dualarm_moveit_config) and keep the group / link naming scheme
  (<side>_panda_arm, <side>_panda_link8) or update dualarm_pick_place/scene.py.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_panda">

  <xacro:arg name="controllers_file" default="$(find dualarm_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="position_gain" default="0.1"/>
  <xacro:arg name="arm_y" default="0.3"/>

  <xacro:include filename="$(find dualarm_description)/urdf/panda_arm.xacro"/>
  <xacro:include filename="$(find dualarm_description)/urdf/dual_panda.ros2_control.xacro"/>

  <xacro:property name="arm_y" value="$(arg arm_y)"/>

  <link name="world"/>

  <xacro:panda_arm prefix="left_" parent="world">
    <origin xyz="0 ${arm_y} 0" rpy="0 0 0"/>
  </xacro:panda_arm>

  <xacro:panda_arm prefix="right_" parent="world">
    <origin xyz="0 ${-arm_y} 0" rpy="0 0 0"/>
  </xacro:panda_arm>

  <xacro:dual_panda_ros2_control
      controllers_file="$(arg controllers_file)"
      position_gain="$(arg position_gain)"/>
</robot>
