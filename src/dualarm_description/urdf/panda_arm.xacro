<?xml version="1.0"?>
<!--
  One Panda arm + hand, with a prefix so two can live in one robot.

  Kinematics and visual/collision meshes follow moveit_resources
  (dual_arm_panda_moveit_config). Added on top, because Gazebo needs them:
    - inertials (values from moveit_resources_panda_description/urdf/panda.urdf.xacro)
    - box collisions for the fingers (a flat pad grips a cube far more reliably
      than a mesh does in the physics engine)
    - a TCP frame between the finger pads
    - finger friction
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Grip tuning knobs (step 3: "안 미끄러지게"). -->
  <xacro:property name="finger_effort" value="20.0"/>   <!-- N, squeeze force per finger -->
  <xacro:property name="finger_mu" value="2.0"/>         <!-- pad friction coefficient -->
  <xacro:property name="finger_mass" value="0.05"/>

  <!-- hand frame -> midpoint between the finger pads -->
  <xacro:property name="tcp_offset" value="0.1034"/>

  <xacro:macro name="panda_link" params="name mesh xyz mass ixx iyy izz ixy ixz iyz">
    <link name="${name}">
      <visual>
        <geometry>
          <mesh filename="package://moveit_resources_panda_description/meshes/visual/${mesh}.dae"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://moveit_resources_panda_description/meshes/collision/${mesh}.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="${ixy}" ixz="${ixz}" iyz="${iyz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- side = 1 for the finger that moves along +y, -1 for the mirrored one -->
  <xacro:macro name="panda_finger" params="name side">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${(1 - side) * pi / 2}"/>
        <geometry>
          <mesh filename="package://moveit_resources_panda_description/meshes/visual/finger.dae"/>
        </geometry>
      </visual>
      <!-- screw mount -->
      <collision>
        <origin xyz="0 ${side * 0.0185} 0.011" rpy="0 0 0"/>
        <geometry><box size="0.022 0.015 0.020"/></geometry>
      </collision>
      <!-- carriage sledge -->
      <collision>
        <origin xyz="0 ${side * 0.0068} 0.0022" rpy="0 0 0"/>
        <geometry><box size="0.022 0.0088 0.0038"/></geometry>
      </collision>
      <!-- diagonal part -->
      <collision>
        <origin xyz="0 ${side * 0.0159} 0.02835" rpy="${side * pi / 6} 0 0"/>
        <geometry><box size="0.0175 0.007 0.0235"/></geometry>
      </collision>
      <!-- rubber pad: the surface that actually touches the object -->
      <collision>
        <origin xyz="0 ${side * 0.00758} 0.04525" rpy="0 0 0"/>
        <geometry><box size="0.0175 0.0152 0.0185"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 ${side * 0.01} 0.025" rpy="0 0 0"/>
        <mass value="${finger_mass}"/>
        <inertia ixx="1.5e-5" iyy="1.5e-5" izz="5.0e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${name}">
      <mu1>${finger_mu}</mu1>
      <mu2>${finger_mu}</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="panda_arm" params="prefix parent *origin">

    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}panda_link0"/>
    </joint>

    <xacro:panda_link name="${prefix}panda_link0" mesh="link0"
        xyz="-0.041018 -0.00014 0.049974" mass="0.629769"
        ixx="0.00315" iyy="0.00388" izz="0.004285" ixy="8.2904E-7" ixz="0.00015" iyz="8.2299E-6"/>
    <xacro:panda_link name="${prefix}panda_link1" mesh="link1"
        xyz="0.003875 0.002081 -0.04762" mass="4.970684"
        ixx="0.70337" iyy="0.70661" izz="0.009117" ixy="-0.000139" ixz="0.006772" iyz="0.019169"/>
    <xacro:panda_link name="${prefix}panda_link2" mesh="link2"
        xyz="-0.003141 -0.02872 0.003495" mass="0.646926"
        ixx="0.007962" iyy="2.811E-2" izz="2.5995E-2" ixy="-3.925E-3" ixz="1.0254E-2" iyz="7.04E-4"/>
    <xacro:panda_link name="${prefix}panda_link3" mesh="link3"
        xyz="2.7518E-2 3.9252E-2 -6.6502E-2" mass="3.228604"
        ixx="3.7242E-2" iyy="3.6155E-2" izz="1.083E-2" ixy="-4.761E-3" ixz="-1.1396E-2" iyz="-1.2805E-2"/>
    <xacro:panda_link name="${prefix}panda_link4" mesh="link4"
        xyz="-5.317E-2 1.04419E-1 2.7454E-2" mass="3.587895"
        ixx="2.5853E-2" iyy="1.9552E-2" izz="2.8323E-2" ixy="7.796E-3" ixz="-1.332E-3" iyz="8.641E-3"/>
    <xacro:panda_link name="${prefix}panda_link5" mesh="link5"
        xyz="-1.1953E-2 4.1065E-2 -3.8437E-2" mass="1.225946"
        ixx="3.5549E-2" iyy="2.9474E-2" izz="8.627E-3" ixy="-2.117E-3" ixz="-4.037E-3" iyz="2.29E-4"/>
    <xacro:panda_link name="${prefix}panda_link6" mesh="link6"
        xyz="6.0149E-2 -1.4117E-2 -1.0517E-2" mass="1.666555"
        ixx="1.964E-3" iyy="4.354E-3" izz="5.433E-3" ixy="1.09E-4" ixz="-1.158E-3" iyz="3.41E-4"/>
    <xacro:panda_link name="${prefix}panda_link7" mesh="link7"
        xyz="1.0517E-2 -4.252E-3 6.1597E-2" mass="7.35522E-1"
        ixx="1.2516E-2" iyy="1.0027E-2" izz="4.815E-3" ixy="-4.28E-4" ixz="-1.19E-3" iyz="-7.41E-4"/>
    <link name="${prefix}panda_link8"/>
    <xacro:panda_link name="${prefix}panda_hand" mesh="hand"
        xyz="-0.01 0 0.03" mass="0.73"
        ixx="0.001" iyy="0.0025" izz="0.0017" ixy="0" ixz="0" iyz="0"/>
    <link name="${prefix}panda_hand_tcp"/>
    <xacro:panda_finger name="${prefix}panda_leftfinger" side="1"/>
    <xacro:panda_finger name="${prefix}panda_rightfinger" side="-1"/>

    <joint name="${prefix}panda_joint1" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 0.333"/>
      <parent link="${prefix}panda_link0"/>
      <child link="${prefix}panda_link1"/>
      <axis xyz="0 0 1"/>
      <limit effort="87" lower="-2.9671" upper="2.9671" velocity="2.3925"/>
    </joint>
    <joint name="${prefix}panda_joint2" type="revolute">
      <origin rpy="${-pi / 2} 0 0" xyz="0 0 0"/>
      <parent link="${prefix}panda_link1"/>
      <child link="${prefix}panda_link2"/>
      <axis xyz="0 0 1"/>
      <limit effort="87" lower="-1.8326" upper="1.8326" velocity="2.3925"/>
    </joint>
    <joint name="${prefix}panda_joint3" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0 -0.316 0"/>
      <parent link="${prefix}panda_link2"/>
      <child link="${prefix}panda_link3"/>
      <axis xyz="0 0 1"/>
      <limit effort="87" lower="-2.9671" upper="2.9671" velocity="2.3925"/>
    </joint>
    <joint name="${prefix}panda_joint4" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0.0825 0 0"/>
      <parent link="${prefix}panda_link3"/>
      <child link="${prefix}panda_link4"/>
      <axis xyz="0 0 1"/>
      <limit effort="87" lower="-3.1416" upper="0.0873" velocity="2.3925"/>
    </joint>
    <joint name="${prefix}panda_joint5" type="revolute">
      <origin rpy="${-pi / 2} 0 0" xyz="-0.0825 0.384 0"/>
      <parent link="${prefix}panda_link4"/>
      <child link="${prefix}panda_link5"/>
      <axis xyz="0 0 1"/>
      <limit effort="12" lower="-2.9671" upper="2.9671" velocity="2.8710"/>
    </joint>
    <joint name="${prefix}panda_joint6" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0 0 0"/>
      <parent link="${prefix}panda_link5"/>
      <child link="${prefix}panda_link6"/>
      <axis xyz="0 0 1"/>
      <limit effort="12" lower="-0.0873" upper="3.8223" velocity="2.8710"/>
    </joint>
    <joint name="${prefix}panda_joint7" type="revolute">
      <origin rpy="${pi / 2} 0 0" xyz="0.088 0 0"/>
      <parent link="${prefix}panda_link6"/>
      <child link="${prefix}panda_link7"/>
      <axis xyz="0 0 1"/>
      <limit effort="12" lower="-2.9671" upper="2.9671" velocity="2.8710"/>
    </joint>
    <joint name="${prefix}panda_joint8" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.107"/>
      <parent link="${prefix}panda_link7"/>
      <child link="${prefix}panda_link8"/>
    </joint>
    <joint name="${prefix}panda_hand_joint" type="fixed">
      <origin rpy="0 0 ${-pi / 4}" xyz="0 0 0"/>
      <parent link="${prefix}panda_link8"/>
      <child link="${prefix}panda_hand"/>
    </joint>
    <joint name="${prefix}panda_hand_tcp_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 ${tcp_offset}"/>
      <parent link="${prefix}panda_hand"/>
      <child link="${prefix}panda_hand_tcp"/>
    </joint>
    <joint name="${prefix}panda_finger_joint1" type="prismatic">
      <origin rpy="0 0 0" xyz="0 0 0.0584"/>
      <parent link="${prefix}panda_hand"/>
      <child link="${prefix}panda_leftfinger"/>
      <axis xyz="0 1 0"/>
      <limit effort="${finger_effort}" lower="0.0" upper="0.04" velocity="0.2"/>
    </joint>
    <joint name="${prefix}panda_finger_joint2" type="prismatic">
      <origin rpy="0 0 0" xyz="0 0 0.0584"/>
      <parent link="${prefix}panda_hand"/>
      <child link="${prefix}panda_rightfinger"/>
      <axis xyz="0 -1 0"/>
      <limit effort="${finger_effort}" lower="0.0" upper="0.04" velocity="0.2"/>
      <mimic joint="${prefix}panda_finger_joint1"/>
    </joint>
  </xacro:macro>
</robot>
