<?xml version="1.0"?>
<package format="3">
  <name>pick_place_damsssss</name>
  <version>0.1.0</version>
  <description>Classic-control pick and place of a cube with one arm of the dual-arm robot, plus success-rate evaluation.</description>
  <maintainer email="todo@example.com">classic control team</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>dualarm_description</exec_depend>
  <exec_depend>dualarm_moveit_config</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
